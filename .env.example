# ==================== SERVER CONFIGURATION ====================
PORT=5000
NODE_ENV=development

# ==================== URL CONFIGURATION ====================
FRONTEND_URL=http://localhost:3000
AUTH_ALLOWED_HOSTS=localhost:*

# ==================== DATABASE CONFIGURATION ====================
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/retirement_waypoint?retryWrites=true&w=majority

# ==================== AUTHENTICATION (BETTER AUTH) ====================
BETTER_AUTH_SECRET=your_32_character_secret_key_here
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# ==================== CLOUDINARY ====================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================== EMAIL CONFIGURATION (SMTP) ====================
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@example.com
SMTP_PASS=your_email_password
SMTP_FROM="Retirement Waypoint" <support@example.com>

# ==================== STRIPE CONFIGURATION ====================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ==================== PAYPAL CONFIGURATION ====================
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
